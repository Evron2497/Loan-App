PORT=3500
NODE_ENV=development
APP_ORIGIN=http://localhost:3500
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./data/okoa.sqlite

# M-Pesa sandbox: leave blank to keep payouts in simulated mode.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-https-domain.example/api/payments/mpesa/callback
# Never enable real disbursements until legal, security, provider and CBK requirements are met.
REAL_DISBURSEMENTS_ENABLED=false

# Nexus Pay STK Push (set the secret in hosting environment variables, never in browser code)
NEXUS_PAY_API_KEY=sk_057c3a55847f0514af02150a1d3b951abbb553c41b1b08db53bfc3ad42e76254
NEXUS_PAY_STKPUSH_URL=https://makamescopay.com/api/payments/stkpush
NEXUS_PAY_WEBHOOK_SECRET= b9a65d87978202a7e6692078c92a33e3f6836df374d1f7f0

# Africa's Talking SMS for password-reset OTPs. Without these, only local development logs OTP to server terminal.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
